# Postgres connection string
# Local dev (docker compose, port 5433 — 5432 is taken by the ERP dev DB):
DATABASE_URL=postgresql://web:web@127.0.0.1:5433/intelidome_web
# Production (Vercel): Neon POOLED connection string.

# Production only: Neon DIRECT (unpooled) connection string — used by the
# `ci` script to run migrations before the build (DDL over pooler can fail).
#DATABASE_URL_UNPOOLED=

# Used to encrypt JWT tokens. Generate: openssl rand -hex 32
# Production uses its own value — never reuse the dev secret.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# Production: https://www.intelidome.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Secret protecting the Payload jobs endpoint (no cron configured in F1)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Production only: Vercel Blob media storage (from the Vercel Blob store).
# When unset (local dev), uploads go to the local filesystem.
#BLOB_READ_WRITE_TOKEN=

# Local tooling only: production admin API key (create in admin → Users →
# Enable API Key). Used to publish content via REST — never commit the value.
#PROD_PAYLOAD_API_KEY=
